# 复制为 .env 后按需修改。Compose 会自动读取本目录的 .env。
WEB_PORT=8080
# 前端与后端默认并列放置；也可改成前端项目的绝对路径。
FRONTEND_PATH=../web-Echo-learning
# Docker Hub 不通时，可改成可访问的镜像源，例如 docker.m.daocloud.io/library。
IMAGE_REGISTRY=docker.io/library
# Go 官方模块代理不通时，可改成 https://goproxy.cn,direct。
GOPROXY=https://proxy.golang.org,direct
# npm 官方源不通时，可改成 https://registry.npmmirror.com。
NPM_CONFIG_REGISTRY=https://registry.npmjs.org

DB_NAME=echo_learning
DB_USER=echo
DB_PASS=change-me-app-password
MYSQL_ROOT_PASSWORD=change-me-root-password
TZ=Asia/Shanghai
